{
  "info": {
    "name": "Student Records API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "studentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. POST - Create student (valid)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set(\"studentId\", pm.response.json()._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Rahul Patil\",\n  \"email\": \"rahul@example.com\",\n  \"course\": \"Computer Engineering\",\n  \"year\": 3,\n  \"division\": \"A\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
